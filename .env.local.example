# Hospital Operations — local server configuration
# Copy this file to .env.local and replace every CHANGE_ME value.
# Do not place production credentials, production database URLs, or real hospital data in this package.

# Local application runtime
NODE_ENV=development
DATABASE_URL=mysql://hospital_ops:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/hospital_operations
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_32_CHARACTER_OR_LONGER_SECRET

# Manager sign-in (required for protected workspaces)
# Register http://localhost:3000/api/oauth/callback with your chosen OAuth provider.
VITE_APP_ID=CHANGE_ME_OAUTH_APPLICATION_ID
OAUTH_SERVER_URL=CHANGE_ME_OAUTH_SERVER_URL
VITE_OAUTH_PORTAL_URL=CHANGE_ME_OAUTH_PORTAL_URL
OWNER_OPEN_ID=CHANGE_ME_OWNER_OPEN_ID
OWNER_NAME=Local Hospital Operations Administrator

# Evidence storage (required only when using evidence uploads)
# The current application uses secure external object storage. Supply local-development credentials
# for a storage service you control, or leave these blank and do not use evidence uploads locally.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional analytics values. Leave blank for local use.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
